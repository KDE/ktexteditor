#: vimode/appcommands.cpp:72
#, kde-format
msgid "All documents written to disk"
msgstr "Svi dokumenti upisani na disk"

#: vimode/appcommands.cpp:74
#, kde-format
msgid "Only some documents were written to disk"
msgstr "Samo neki dokumenti su upisani na disk"

#: vimode/appcommands.cpp:79
#, kde-format
msgid "Document written to disk"
msgstr "Dokument upisan na disk"

#: vimode/appcommands.cpp:212
#, kde-format
msgid ""
"<p><b>w/wa &mdash; write document(s) to disk</b></p><p>Usage: <tt><b>w[a]</"
"b></tt></p><p>Writes the current document(s) to disk. It can be called in "
"two ways:<br /> <tt>w</tt> &mdash; writes the current document to disk<br /> "
"<tt>wa</tt> &mdash; writes all documents to disk.</p><p>If no file name is "
"associated with the document, a file dialog will be shown.</p>"
msgstr ""
"<p><b><tt>w/wa</tt> — upisivanje dokumenata na disk</b></p><p>Upotreba: "
"<tt><b>w[a]</b></tt></p><p>Upisuje tekuće dokumente na disk. Može se pozvati "
"na dva načina:<br /> <tt>w</tt> — upisuje tekući dokument na disk;<br /> "
"<tt>wa</tt> — upisuje sve dokumente na disk.</p><p>Ako dokument nije povezan "
"sa imenom fajla, pojaviće se fajl dijalog.</p>"

#: vimode/appcommands.cpp:223
#, kde-format
msgid ""
"<p><b>q/qa/wq/wqa &mdash; [write and] quit</b></p><p>Usage: <tt><b>[w]q[a]</"
"b></tt></p><p>Quits the application. If <tt>w</tt> is prepended, it also "
"writes the document(s) to disk. This command can be called in several ways:"
"<br /> <tt>q</tt> &mdash; closes the current view.<br /> <tt>qa</tt> &mdash; "
"closes all views, effectively quitting the application.<br /> <tt>wq</tt> "
"&mdash; writes the current document to disk and closes its view.<br /> "
"<tt>wqa</tt> &mdash; writes all documents to disk and quits.</p><p>In all "
"cases, if the view being closed is the last view, the application quits. If "
"no file name is associated with the document and it should be written to "
"disk, a file dialog will be shown.</p>"
msgstr ""
"<p><b><tt>q/qa/wq/wqa</tt> — (upisivanje i) napuštanje</b></p><p>Upotreba: "
"<tt><b>[w]q[a]</b></tt></p><p>Napušta program. Ako se ispred stavi <tt>w</"
"tt>, takođe upisuje dokumente na disk. Ovu naredbu možete pozvati na više "
"načina:<br /> <tt>q</tt> — zatvara tekući prikaz;<br /> <tt>qa</tt> — "
"zatvara sve prikaze, posljedično napuštajući program;<br /> <tt>wq</tt> — "
"upisuje dokument na disk i zatvara njegov prikaz;<br /> <tt>wqa</tt> — "
"upisuje sve dokumente na disk i napušta.</p><p>U svim slučajevima, ako je "
"zatvoreni prikaz bio posljednji program se napušta. Ako dokument nije "
"povezan sa imenom fajla a treba ga upisati na disk, pojaviće se fajl dijalog."
"</p>"

#: vimode/appcommands.cpp:238
#, kde-format
msgid ""
"<p><b>x/xa &mdash; write and quit</b></p><p>Usage: <tt><b>x[a]</b></tt></"
"p><p>Saves document(s) and quits (e<b>x</b>its). This command can be called "
"in two ways:<br /> <tt>x</tt> &mdash; closes the current view.<br /> <tt>xa</"
"tt> &mdash; closes all views, effectively quitting the application.</p><p>In "
"all cases, if the view being closed is the last view, the application quits. "
"If no file name is associated with the document and it should be written to "
"disk, a file dialog will be shown.</p><p>Unlike the 'w' commands, this "
"command only writes the document if it is modified.</p>"
msgstr ""
"<p><b><tt>x/xa</tt> — upisivanje i napuštanje</b></p><p>Upotreba: "
"<tt><b>x[a]</b></tt></p><p>Upisuje dokumente na disk i napušta. Ovu naredbu "
"možete pozvati na dva načina:<br /> <tt>x</tt> — zatvara tekući prikaz;<br /"
"> <tt>xa</tt> — zatvara sve prikaze, posljedično napuštajući program.</"
"p><p>U svim slučajevima, ako je zatvoreni prikaz bio posljednji program se "
"napušta. Ako dokument nije povezan sa imenom fajla a treba ga upisati na "
"disk, pojaviće se fajl dijalog.</p><p>Za razliku od <tt>w</tt>-naredbi, ove "
"upisuju dokument samo ako je bio izmijenjen.</p>"

#: vimode/appcommands.cpp:252
#, kde-format
msgid ""
"<p><b>sp,split&mdash; Split horizontally the current view into two</b></"
"p><p>Usage: <tt><b>sp[lit]</b></tt></p><p>The result is two views on the "
"same document.</p>"
msgstr ""
"<p><b><tt>sp,split</tt> — podjela tekućeg prikaza na dva</b></p><p>Upotreba: "
"<tt><b>sp[lit]</b></tt></p><p>Rezultat je dva prikaza istog dokumenta.</p>"

#: vimode/appcommands.cpp:258
#, kde-format
msgid ""
"<p><b>vs,vsplit&mdash; Split vertically the current view into two</b></"
"p><p>Usage: <tt><b>vs[plit]</b></tt></p><p>The result is two views on the "
"same document.</p>"
msgstr ""
"<p><b><tt>vs,vsplit</tt> — uspravna podjela tekućeg prikaza na dva</b></"
"p><p>Upotreba: <tt><b>vs[plit]</b></tt></p><p>Rezultat je dva prikaza istog "
"dokumenta.</p>"

#: vimode/appcommands.cpp:264
#, kde-format
msgid ""
"<p><b>clo[se]&mdash; Close the current view</b></p><p>Usage: <tt><b>clo[se]</"
"b></tt></p><p>After executing it, the current view will be closed.</p>"
msgstr ""
"<p><b><tt>clo[se]</tt> — zatvaranje tekućeg prikaza</b></p><p>Upotreba: "
"<tt><b>clo[se]</b></tt></p><p>Po izvršenju, tekući prikaz će biti zatvoren.</"
"p>"

#: vimode/appcommands.cpp:270
#, kde-format
msgid ""
"<p><b>[v]new &mdash; split view and create new document</b></p><p>Usage: "
"<tt><b>[v]new</b></tt></p><p>Splits the current view and opens a new "
"document in the new view. This command can be called in two ways:<br /> "
"<tt>new</tt> &mdash; splits the view horizontally and opens a new document."
"<br /> <tt>vnew</tt> &mdash; splits the view vertically and opens a new "
"document.<br /></p>"
msgstr ""
"<p><b><tt>[v]new</tt> — podjela prikaza i stvaranje novog dokumenta</b></"
"p><p>Upotreba: <tt><b>[v]new</b></tt></p><p>Dijeli tekući prikaz i otvara "
"novi dokument u novom prikazu. Ovu naredbu možete pozvati na dva načina:<br /"
"> <tt>new</tt> — dijeli prikaz vodoravno i otvara novi dokument;<br /> "
"<tt>vnew</tt> — dijeli prikaz uspravno i otvara novi dokument.<br /></p>"

#: vimode/appcommands.cpp:280
#, kde-format
msgid ""
"<p><b>e[dit] &mdash; reload current document</b></p><p>Usage: <tt><b>e[dit]</"
"b></tt></p><p>Starts <b>e</b>diting the current document again. This is "
"useful to re-edit the current file, when it was modified on disk.</p>"
msgstr ""
"<p><b>e[dit] — ponovno učitavanje tekućeg dokumenta</b></p><p>Upotreba: "
"<tt><b>e[dit]</b></tt></p><p>Ponovo započinje uređivanje (<b>e</b>dit) "
"tekućeg dokumenta. Korisno je za ponovno uređivanje tekućeg fajla kada je "
"izmijenjen na disku.</p>"

#: vimode/appcommands.cpp:528
#, kde-format
msgid ""
"<p><b>b,buffer &mdash; Edit document N from the document list</b></"
"p><p>Usage: <tt><b>b[uffer] [N]</b></tt></p>"
msgstr ""
"<p><b><tt>b,buffer</tt> — uređivanje n‑tog dokumenta sa spiska</b></"
"p><p>Upotreba: <tt><b>b[uffer] [n]</b></tt></p>"

#: vimode/appcommands.cpp:533
#, kde-format
msgid ""
"<p><b>bp,bprev &mdash; previous buffer</b></p><p>Usage: <tt><b>bp[revious] "
"[N]</b></tt></p><p>Goes to <b>[N]</b>th previous document (\"<b>b</b>uffer"
"\") in document list. </p><p> <b>[N]</b> defaults to one. </p><p>Wraps "
"around the start of the document list.</p>"
msgstr ""
"<p><b><tt>bp,bprev</tt> — prethodni bafer</b></p><p>Upotreba: "
"<tt><b>bp[revious] [n]</b></tt></p><p>Prelazi na n‑ti prethodni dokument "
"(„bafer“) u spisku dokumenata. <b>[n]</b> je podrazumijevano 1.</"
"p><p>Omotava oko početka spiska dokumenata.</p>"

#: vimode/appcommands.cpp:541
#, kde-format
msgid ""
"<p><b>bn,bnext &mdash; switch to next document</b></p><p>Usage: "
"<tt><b>bn[ext] [N]</b></tt></p><p>Goes to <b>[N]</b>th next document "
"(\"<b>b</b>uffer\") in document list.<b>[N]</b> defaults to one. </"
"p><p>Wraps around the end of the document list.</p>"
msgstr ""
"<p><b><tt>bn,bnext</tt> — prebacivanje na sljedeći dokument</b></"
"p><p>Upotreba: <tt><b>bn[ext] [n]</b></tt></p><p>Prelazi na n‑ti sljedeći "
"dokument („bafer“) u spisku dokumenata. <b>[n]</b> je podrazumijevano 1.</"
"p><p>Omotava oko kraja spiska dokumenata.</p>"

#: vimode/appcommands.cpp:549
#, kde-format
msgid ""
"<p><b>bf,bfirst &mdash; first document</b></p><p>Usage: <tt><b>bf[irst]</b></"
"tt></p><p>Goes to the <b>f</b>irst document (\"<b>b</b>uffer\") in document "
"list.</p>"
msgstr ""
"<p><b><tt>bf,bfirst</tt> — prvi dokument</b></p><p>Upotreba: "
"<tt><b>bf[irst]</b></tt></p><p>Prelazi na prvi dokument („bafer“) u spisku "
"dokumenata.</p>"

#: vimode/appcommands.cpp:555
#, kde-format
msgid ""
"<p><b>bl,blast &mdash; last document</b></p><p>Usage: <tt><b>bl[ast]</b></"
"tt></p><p>Goes to the <b>l</b>ast document (\"<b>b</b>uffer\") in document "
"list.</p>"
msgstr ""
"<p><b><tt>bl,blast</tt> — posljednji dokument</b></p><p>Upotreba: "
"<tt><b>bl[ast]</b></tt></p><p>Prelazi na posljednji dokument („bafer“) u "
"spisku dokumenata.</p>"

#: vimode/appcommands.cpp:561
#, kde-format
msgid "<p><b>ls</b></p><p>list current buffers<p>"
msgstr "<p><b><tt>ls</tt> — nabrajanje dokumenata</b></p>"

